{
    "trading_mode": "futures",
    "margin_mode": "isolated",
    "max_open_trades": 6,
    "stake_currency": "USDC",
    "stake_amount": 50,
    "tradable_balance_ratio": 0.99,
    "dry_run": true,
    "dry_run_wallet": 1000,
    "cancel_open_orders_on_exit": false,

    "exchange": {
        "name": "hyperliquid",
        "key": "",
        "secret": "",
        "pair_whitelist": [
            "BTC/USDC:USDC",
            "ETH/USDC:USDC",
            "SOL/USDC:USDC",
            "XRP/USDC:USDC",
            "ADA/USDC:USDC",
            "LINK/USDC:USDC"
        ],
        "pair_blacklist": []
    },

    "pairlists": [
        {"method": "StaticPairList"}
    ],

    "entry_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exit_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1
    },

    "freqai": {
        "enabled": true,
        "override_exchange_checks": true,
        "purge_old_models": 2,
        "train_period_days": 30,
        "backtest_period_days": 7,
        "identifier": "zap_v1",
        "feature_parameters": {
            "include_timeframes": ["5m", "15m", "1h"],
            "include_corr_pairlist": [
                "BTC/USDC:USDC",
                "ETH/USDC:USDC",
                "SOL/USDC:USDC"
            ],
            "label_period_candles": 24,
            "include_shifted_candles": 1,
            "indicator_periods_candles": [20],
            "DI_threshold": 0.9,
            "weight_factor": 0.9,
            "principal_component_analysis": false,
            "plot_feature_importances": 0
        },
        "data_split_parameters": {
            "test_size": 0.33,
            "random_state": 1
        },
        "model_training_parameters": {
            "n_estimators": 800,
            "learning_rate": 0.02,
            "max_depth": 6,
            "num_leaves": 32,
            "min_child_samples": 30,
            "reg_alpha": 0.1,
            "reg_lambda": 0.1,
            "verbosity": -1
        }
    },

    "strategy": "ZAPStrategy",
    "strategy_path": "user_data/strategies/",
    "timeframe": "5m",

    "zap": {
        "pairs_count": 20,
        "max_open_trades": 6,
        "leverage": {"min": 2, "max": 8},
        "entry": {
            "top_k": 3,
            "min_predicted_return": 0.005
        }
    }
}
